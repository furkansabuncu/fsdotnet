# Build-time address of the .NET API.
#
# Leave it empty and the one server-backed tool (Regex Tester) turns itself
# off and falls back to the JavaScript engine. That is exactly the situation
# on static hosting, and it is a supported state — not a broken one.
#
# Set it in the host dashboard if you deploy the API somewhere; otherwise
# leave it unset.
VITE_API_URL=

# Public address of the site, used for canonical, hreflang, sitemap and the
# share cards — and, when it carries a path, for the asset base too.
#
# CI sets this from the repository name, because GitHub Pages project sites
# live under /<repo>/. Leave it unset locally: the dev server runs at the
# root and the fallback in Seo.tsx covers a local build.
VITE_SITE_URL=
