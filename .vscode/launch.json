{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "api (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "api: build",
      "program": "${workspaceFolder}/api/src/Fsbox.Api/bin/Debug/net10.0/Fsbox.Api.dll",
      "cwd": "${workspaceFolder}/api/src/Fsbox.Api",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" },
      "console": "internalConsole",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on: +(https?://[^ ]+)",
        "uriFormat": "%s/api/v1/health"
      }
    },
    {
      "name": "web (Chrome)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "web: dev",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web"
    }
  ],
  "compounds": [
    {
      "name": "full stack (api + web)",
      "configurations": ["api (.NET)", "web (Chrome)"],
      "stopAll": true
    }
  ]
}
